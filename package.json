{
  "name": "pl8ypus-linkedin-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config src/frontend/dist/pl8ypus_linkedin_scheduler/wrangler.json",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply pl8ypus-scheduler-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pl8ypus-scheduler-db --remote"
  },
  "dependencies": {
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  }
}
