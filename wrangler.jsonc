{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gs-social-scheduler",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "routes": [
    {
    "pattern": "linkedin-scheduler.greg-staunton.com/*",
    "zone_name": "greg-staunton.com"
    }
  ],
  // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD must be set (dashboard or
  // `wrangler deploy` vars) to the Access app protecting this deployment.
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCESS_TEAM_DOMAIN": "pl8ypus.cloudflareaccess.com",
    "CF_ACCESS_AUD": "24febcf5978165a5704dad393b19ca5ecab83656111ca66701ee626d3d875622",
    "LINKEDIN_REDIRECT_URI": "https://linkedin-scheduler.greg-staunton.com/api/admin/linkedin/callback",
    "LINKEDIN_API_VERSION": "202506"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pl8ypus-scheduler-db-prod",
      "database_id": "3a394d64-61f2-442a-9263-6c9f475def95",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./src/frontend/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
