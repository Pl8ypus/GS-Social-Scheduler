{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pl8ypus-linkedin-scheduler-dev",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // Top-level config is used by local `wrangler dev`, which has no Cloudflare
  // Access proxy in front, so ENVIRONMENT=development bypasses Access locally.
  // Staging/production below set ENVIRONMENT explicitly and fail closed.
  "vars": {
    "ENVIRONMENT": "development"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "SCHEDULED_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pl8ypus-scheduler-db-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "env": {
    "staging": {
      "name": "pl8ypus-linkedin-scheduler-staging",
      // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD must be set (dashboard or
      // `wrangler deploy` vars) to the Access app protecting this deployment.
      "vars": {
        "ENVIRONMENT": "staging",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": ""
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "SCHEDULED_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pl8ypus-scheduler-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "gs-social-scheduler",
      "routes": [
        {
          "pattern": "social-scheduler.greg-staunton.com",
          "custom_domain": true
        }
      ],
      // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD must be set (dashboard or
      // `wrangler deploy` vars) to the Access app protecting this deployment.
      "vars": {
        "ENVIRONMENT": "production",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": ""
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "SCHEDULED_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pl8ypus-scheduler-db-prod",
          "database_id": "3a394d64-61f2-442a-9263-6c9f475def95",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
